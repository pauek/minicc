// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
	{
		"label": "Debug MiniCC",
		"build": {
			"command": "make",
			"args": ["debug"],
			"cwd": "$ZED_WORKTREE_ROOT",
		},
		"program": "$ZED_WORKTREE_ROOT/minicc",
		"args": ["config", "tests/parser/incr_stmt/incr_stmt.cc"],
		"request": "launch",
		"adapter": "CodeLLDB",
	},
	{
		"label": "Debug Config Generator",
		"build": {
			"command": "make",
			"args": [""],
			"cwd": "$ZED_WORKTREE_ROOT/config",
		},
		"program": "$ZED_WORKTREE_ROOT/config/gen",
		"cwd": "$ZED_WORKTREE_ROOT/config",
		"args": [""],
		"request": "launch",
		"adapter": "CodeLLDB",
	},]
