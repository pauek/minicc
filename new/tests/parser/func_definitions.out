function "sum2"(a: int, b: int): int
    return (a + b)

function "mul2"(a: double, b: double): double
    return (a * b)

function "sub2"(a: char, b: char): char
    return (a - b)

function "div2"(aa: int, bb: int): int
    return (aa / bb)

function "mod2"(aa: int, bb: int): int
    return (aa % bb)

