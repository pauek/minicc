
void ConfigTree::read_from_file() {
    ifstream fin(".minicc");

    vector<uint16_t>       curr_id(1, 0);
    vector<vector<string>> stack(1, {"<root>"});

    uint8_t curr_level = 0, last_level = 0;
    int     lin = 1;
    string  line;
    while (getline(fin, line)) {
        // Skip empty lines
        if (all_spaces(line)) {
            continue;
        }

        // Split line into name and level
        auto [name, level] = split_config_line(line, lin);

        // Can't change level more than 1 upwards
        auto level_change = level - last_level;
        if (level_change > 1) {
            error(
                ".minicc:{}:0: Config level should change by 1 (but changed from {} to {}).",
                lin,
                last_level,
                level
            );
        }

        if (level_change == 0) {
            stack[level].push_back(name);
        } else if (level_change == 1) {
            // Entering a branch
            if (level >= stack.size()) {
                stack.resize(level + 1);
                curr_id.resize(level + 1, 0);
            }
            stack[level].push_back(name);
            curr_id[level]++;
        } else {
        	// Exiting one *or more* branches
         	while (last_level > level) {

          	}
        }

        // For next iteration
        lin++;
        last_level = level;
    }
}
